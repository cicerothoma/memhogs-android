    <string name="force_stop_title">force stop %1$s?</string>
    <string name="force_stop_explanation">closes it even if it\'s open, and stops its services. its alarms, scheduled jobs and notifications stay off until you open it again.</string>

    <!-- Terminal transcripts are typed out line by line; keep lines under 42 characters. -->
    <string name="setup_error">error: shell access required</string>
    <string name="setup_explanation">android hides other apps\' memory from\nnormal apps. shizuku unlocks it the way\na usb debugger would. no root needed.</string>
    <string name="setup_steps">"  1. get shizuku\n  2. start its service (once per boot)\n  3. come back and grant access"</string>
    <string name="setup_play_store_note">note: if the play store calls shizuku\nincompatible with your android version,\ninstall the apk from its github releases.</string>
    <string name="setup_open_shizuku">open shizuku</string>
    <string name="setup_get_shizuku">get shizuku · github</string>
    <string name="setup_check_again">check again</string>

    <string name="permission_status">running · memhogs not authorized</string>
    <string name="permission_explanation">one tap left. grant access and every\napp on this phone lines up by memory.</string>
    <string name="permission_grant">grant access</string>

    <string name="error_line">error: %1$s</string>
    <string name="error_empty_meminfo">dumpsys returned no per-process data</string>
    <string name="error_shell_did_not_start">shizuku did not start the shell</string>
    <string name="error_shell_did_not_start_hint">shizuku is running, but the memhogs\nshell it launches never answered.\nsome systems, like hyperos 3, block\nit. restart shizuku, then retry.</string>
